{
  "name": "flowvanti",
  "productName": "FLOWVANTI",
  "version": "1.0.0",
  "description": "FLOWVANTI project command",
  "author": "FLOWVANTI",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite",
    "dist": "node scripts/pack-windows.cjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "vite": "^8.2.1"
  },
  "build": {
    "appId": "app.flowvanti.desktop",
    "productName": "FLOWVANTI",
    "copyright": "Copyright © FLOWVANTI",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist-ui/**/*",
      "dashboard.html",
      "fonts/**/*",
      "desktop/flowvanti.ico"
    ],
    "extraMetadata": {
      "name": "flowvanti"
    },
    "forceCodeSigning": false,
    "win": {
      "icon": "desktop/flowvanti.ico",
      "legalTrademarks": "FLOWVANTI",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "flowvanti_x64.${ext}",
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "timeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "FLOWVANTI",
      "shortcutName": "FLOWVANTI",
      "installerIcon": "desktop/flowvanti.ico",
      "uninstallerIcon": "desktop/flowvanti.ico",
      "installerHeaderIcon": "desktop/flowvanti.ico",
      "uninstallDisplayName": "FLOWVANTI",
      "include": "build/installer.nsh",
      "artifactName": "flowvanti_x64.${ext}"
    }
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
